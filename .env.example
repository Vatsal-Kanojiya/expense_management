# Copy to .env and fill in. .env is gitignored; this file documents the keys.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Required. No default in settings.py on purpose: an unset SECRET_KEY
# should crash at startup rather than fall back to a shared value.
SECRET_KEY=

# Defaults to False if unset, so forgetting it fails safe.
DEBUG=True

# Comma separated. Must be non-empty once DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Defaults to local SQLite. For Postgres:
#   DATABASE_URL=postgres://user:password@localhost:5432/expense_tracker
# DATABASE_URL=

# Optional. Defaults to the console backend, which prints emails to stdout.
# For real delivery: django.core.mail.backends.smtp.EmailBackend (plus the
# EMAIL_HOST / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD settings it needs).
# EMAIL_BACKEND=
# DEFAULT_FROM_EMAIL=

# Optional. Which vision model reads an uploaded bill photo. Defaults to
# "fake" -- a fixed, deterministic result, no network, no key -- so bill
# scanning works out of the box in development and CI. One of:
#   fake | claude | gemini | openai
# BILL_SCAN_PROVIDER=

# Optional overrides for which model each provider calls, if you want
# something other than the built-in default.
# BILL_SCAN_CLAUDE_MODEL=
# BILL_SCAN_GEMINI_MODEL=
# BILL_SCAN_OPENAI_MODEL=

# Required only by the provider named in BILL_SCAN_PROVIDER above -- each
# SDK reads its own key directly, so only set the one you are using.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ----------------------------------------------------------------------
# Docker only. Read by compose.yaml and compose.dev.yaml; a plain
# `manage.py runserver` ignores everything below. docs/DOCKER.md explains
# each one. `make env` copies this file to .env and fills in SECRET_KEY,
# HOST_UID and HOST_GID for you.
# ----------------------------------------------------------------------

# Ports on your machine. Only the host side moves; inside the stack the
# services keep 8000, 5432 and 6379, so nothing else needs changing.
WEB_PORT=8765
POSTGRES_PORT=5433
REDIS_PORT=6380

# Which interface each port listens on. 127.0.0.1 is this machine only.
# 0.0.0.0 opens it to your network -- and Docker publishes ports ahead of
# ufw, so a firewall rule will not close it again. Separate switches so the
# site can be opened to a phone without opening the database. To do that,
# set WEB_BIND_ADDRESS=0.0.0.0 and add your LAN IP to ALLOWED_HOSTS above.
WEB_BIND_ADDRESS=127.0.0.1
DATA_BIND_ADDRESS=127.0.0.1

# Postgres reads these only when its volume is first created; changing
# them later does not change an existing database (docs/DOCKER.md §14).
# The password goes inside a URL: letters, digits, - and _ only.
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense-local-only

# Your user and group id (`id -u`, `id -g`), so files the containers write
# into your checkout -- a new migration, say -- belong to you.
HOST_UID=1000
HOST_GID=1000
